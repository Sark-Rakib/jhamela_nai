# Environment for Jhamela Nai
CLIENT_URL=http://localhost:3000,http://localhost:3111
COOKIE_NAME=jn_token
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
JWT_EXPIRES_IN=7d
JWT_SECRET=
MONGODB_DB=jhamela_nai
MONGODB_URI=
# Leave blank in production: the API is served same-origin at /api.
# Only set this for local dev against the standalone Express server.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CONTACT_EMAIL=hello@jhamelanai.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
PORT=4000

# Seed + end-to-end test accounts (used by `npm run seed` and `npm run test:e2e`).
USER_EMAIL=demo@jhamelanai.com
USER_PASSWORD=
ADMIN_EMAIL=admin@jhamelanai.com
ADMIN_PASSWORD=
