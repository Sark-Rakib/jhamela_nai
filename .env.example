# =============================================================================
# Jhamela Nai — environment template
#
#   cp .env.example .env       (the real `.env` is git-ignored)
#
# The API reads this file automatically; a `server/.env` next to the Express
# workspace overrides it if you prefer to keep secrets there. Shell variables
# always win over both.
# =============================================================================

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CONTACT_EMAIL=hello@jhamelanai.com

# ─── Backend (Express + MongoDB) ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Required — the API refuses to boot without it.
#   local mongod:  mongodb://127.0.0.1:27017/jhamela-nai
#   Atlas:         mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/jhamela-nai
MONGODB_URI=

# Database to use when MONGODB_URI has no path of its own (a path in the URI
# wins). Never leave this empty — a path-less URI falls back to `test`.
MONGODB_DB=jhamela_nai

# Session signing secret (16+ chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated web origins allowed to send credentials (cookies require
# exact matches). Add every port you preview on, e.g. ,http://localhost:3111
CLIENT_URL=http://localhost:3000
COOKIE_NAME=jn_token

# ─── AI assistant (optional) ─────────────────────────────────────────────────
# Leave empty to use the built-in keyword engine — every feature still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Seed script (`npm run seed`) ────────────────────────────────────────────
# Change these before any real deployment.
ADMIN_EMAIL=admin@jhamelanai.com
ADMIN_PASSWORD=
USER_EMAIL=demo@jhamelanai.com
USER_PASSWORD=
