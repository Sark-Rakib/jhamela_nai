{
  "buildCommand": "npm run build:api && npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" }
  ]
}
